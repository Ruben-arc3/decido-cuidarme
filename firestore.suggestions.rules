rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /publicSuggestions/{suggestionId} {
      allow create: if request.resource.data.keys().hasOnly([
          'category',
          'message',
          'page',
          'status',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'category',
          'message',
          'page',
          'status',
          'createdAt'
        ])
        && request.resource.data.category in ['idea', 'error', 'content', 'other']
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 1200
        && request.resource.data.page is string
        && request.resource.data.page.size() <= 160
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;

      // Visitors may submit; reading and moderation stay in trusted Firebase Console access.
      allow read, update, delete: if false;
    }

    // Temporary public signal used only by the shutdown screen simulation.
    // Writes are limited to a short time window and cannot store arbitrary fields.
    match /siteSignals/shutdown {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly([
          'activeUntil',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'activeUntil',
          'updatedAt'
        ])
        && request.resource.data.activeUntil is int
        && request.resource.data.activeUntil >= request.time.toMillis() - 60000
        && request.resource.data.activeUntil <= request.time.toMillis() + 60000
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
