rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // All protected data requires a signed-in Firebase user.
    function signedIn() {
      return request.auth != null;
    }

    // These claims are assigned by an administrator, not by the public registration form.
    function teacher() {
      return signedIn()
        && request.auth.token.role == 'teacher'
        && request.auth.token.school == 'villa-esther';
    }

    // Students may read their own profile and results, but may not edit scores.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'displayName',
          'email',
          'createdAt',
          'updatedAt',
          'school'
        ])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.school == 'villa-esther';

      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'updatedAt'
        ]);

      allow delete: if false;

      match /results/{resultId} {
        allow read: if signedIn() && request.auth.uid == uid;

        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly([
            'area',
            'total',
            'correct',
            'percent',
            'byArea',
            'createdAt',
            'source',
            'classId'
          ])
          && request.resource.data.total is int
          && request.resource.data.correct is int
          && request.resource.data.percent is int
          && (
            !('classId' in request.resource.data)
            || exists(
              /databases/$(database)/documents/users/$(uid)/memberships/$(request.resource.data.classId)
            )
          );

        allow update, delete: if false;
      }

      // Membership records are assigned by trusted server-side tools.
      match /memberships/{classId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // Students can read published Villa Esther questions; teachers manage them.
    match /questions/{questionId} {
      allow read: if signedIn()
        && resource.data.status == 'published'
        && resource.data.school == 'villa-esther';

      allow create, update, delete: if teacher();
    }

    // Teachers can manage only classes that they own.
    match /classes/{classId} {
      allow read: if teacher() && resource.data.teacherUid == request.auth.uid;

      allow create: if teacher()
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'name',
          'teacherUid',
          'joinCode',
          'active',
          'createdAt',
          'school'
        ])
        && request.resource.data.school == 'villa-esther';

      allow update: if teacher()
        && resource.data.teacherUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'active'
        ]);

      allow delete: if teacher() && resource.data.teacherUid == request.auth.uid;

      // Membership data is read-only from the client.
      match /members/{uid} {
        allow read: if signedIn()
          && (
            request.auth.uid == uid
            || (
              teacher()
              && get(/databases/$(database)/documents/classes/$(classId)).data.teacherUid
                == request.auth.uid
            )
          );

        allow write: if false;
      }
    }

    // A single public counter for the platform's animated appreciation button.
    // Each visitor can only create the counter at 1 or increase it by exactly 1.
    match /publicCounters/platformClicks {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count is int
        && request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count is int
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    // Default-deny: each new collection needs an explicit rule.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
